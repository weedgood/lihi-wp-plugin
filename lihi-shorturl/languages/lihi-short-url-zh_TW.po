#: includes/add-lihi-column.php
#: includes/add-shorturl-column.php
msgid "Short URL"
msgstr "短網址"

#: includes/service/lihi-service.php
msgid "No token returned from lihi API."
msgstr "lihi API 未回傳 token。"

#: includes/service/lihi-service.php
msgid "No short_url returned from lihi API."
msgstr "lihi API 未回傳 short_url。"

#: includes/service/lihi-service.php
msgid "Could not resolve URL for %1$s %2$d."
msgstr "無法取得 %1$s %2$d 的 URL。"

#: includes/add-shorturl-column.php
msgid "Copied!"
msgstr "已複製！"

#: includes/add-shorturl-column.php
msgid "Invalid post ID or type."
msgstr "無效的 ID 或類型。"

#: includes/add-shorturl-column.php
msgid "Your lihi email has not been verified yet. Please open Settings → lihi Short URL and click Save & Verify to resend the verification email."
msgstr "您的 lihi Email 尚未完成驗證，請至「設定 → lihi 短網址」點擊「儲存並驗證」重新寄送驗證信。"

#: includes/add-shorturl-column.php
msgid "lihi email is not configured. Please set it in Settings → lihi Short URL."
msgstr "lihi 尚未設定 Email，請至「設定 → lihi 短網址」填寫。"

#: includes/add-shorturl-column.php
msgid "lihi redirect domain is not configured. Please choose one in Settings → lihi Short URL."
msgstr "lihi 尚未選擇短網址網域，請至「設定 → lihi 短網址」選擇。"

#: includes/add-shorturl-column.php
#. translators: %s: validation error message returned by the lihi API.
msgid "lihi API rejected the request: %s"
msgstr "lihi API 拒絕此請求：%s"

#: includes/add-shorturl-column.php
msgid "Failed to generate short URL. Please try again later."
msgstr "產生短網址失敗，請稍後再試。"

#: includes/settings.php
msgid "Email"
msgstr "Email"

#: includes/settings.php
msgid "lihi Short URL"
msgstr "lihi 短網址"

#: includes/settings.php
msgid "Email used to authenticate with the lihi service. Saving triggers email verification; leave blank to disable the plugin."
msgstr "用於 lihi 服務驗證身分的 Email；儲存後會觸發驗證流程，留白則停用外掛。"

#: includes/settings.php
msgid "lihi email cleared. Short URL generation is disabled until a new email is verified."
msgstr "已清除 lihi Email；在新 Email 完成驗證前，短網址功能將停用。"

#: includes/settings.php
msgid "lihi Short URL Settings"
msgstr "lihi 短網址設定"

#: includes/settings.php
msgid "Save & Verify"
msgstr "儲存並驗證"

#: includes/settings.php
msgid "You do not have permission to update this setting."
msgstr "您沒有權限更新此設定。"

#: includes/settings.php
msgid "Please enter a valid email address."
msgstr "請輸入有效的 Email 地址。"

#: includes/settings.php
msgid "lihi rejected the email address. Please check the format and try again."
msgstr "lihi 拒絕了此 Email 地址，請確認格式後再試一次。"

#: includes/settings.php
msgid "The lihi auth service is unavailable. Please try again later."
msgstr "lihi 驗證服務目前無法連線，請稍後再試。"

#: includes/settings.php
msgid "Too many verification attempts. Please wait a moment and try again."
msgstr "驗證嘗試過於頻繁，請稍候再試。"

#: includes/settings.php
msgid "✓ Email verified."
msgstr "✓ Email 已驗證。"

#: includes/settings.php
msgid "Verification email sent. Please click the link in that email to finish verification."
msgstr "驗證信已寄出，請點擊信中的連結完成驗證。"

#: includes/settings.php
msgid "Email not verified yet. Click Save & Verify to resend the verification email."
msgstr "Email 尚未完成驗證，請點擊「儲存並驗證」重新寄送驗證信。"

#: includes/settings.php
msgid "The lihi service is temporarily unavailable. Please try again later."
msgstr "lihi 服務目前無法連線，請稍後再試。"

#: includes/settings.php
msgid "Could not load account information."
msgstr "無法載入帳號資訊。"

#: includes/settings.php
msgid "Account"
msgstr "帳號"

#: includes/settings.php
msgid "Subscribe Plan"
msgstr "訂閱方案"

#: includes/settings.php
msgid "Plan End Date"
msgstr "方案到期日"

#: includes/settings.php
msgid "Redirect domain"
msgstr "短網址網域"

#: includes/settings.php
msgid "Redirect domain used when creating new lihi short URLs."
msgstr "建立新 lihi 短網址時使用的網域。"

#: includes/settings.php
msgid "Save"
msgstr "儲存"

#: includes/settings.php
msgid "Invalid redirect domain."
msgstr "無效的短網址網域。"

#: includes/settings.php
msgid "Redirect domain saved."
msgstr "短網址網域已儲存。"

#: includes/settings.php
msgid "Redirect domain cleared."
msgstr "已清除短網址網域。"

#: includes/settings.php
msgid "— Please Choose —"
msgstr "— 請選擇 —"

#: includes/settings.php
msgid "(none)"
msgstr "（無）"

#: includes/settings.php
msgid "—"
msgstr "—"

#: includes/settings.php
msgid "(none available)"
msgstr "（尚無）"


#. Description of the plugin
msgid "Adds a one-click \"lihi\" button to generate and copy short URLs, including posts, pages, media and all post-type list tables."
msgstr "在列表中新增一鍵生成短網址並複製的按鈕 \"lihi\"，包含文章、頁面與媒體等所有內容行列表。"
