#: includes/add-lihi-column.php
#: includes/add-shorturl-column.php
msgid "Short URL"
msgstr "短網址"

#: includes/service/lihi-service.php
msgid "No token returned from Lihi API."
msgstr "Lihi API 未回傳 token。"

#: includes/service/lihi-service.php
msgid "No short_url returned from Lihi API."
msgstr "Lihi API 未回傳 short_url。"

#: includes/service/lihi-service.php
msgid "Could not resolve URL for %1$s %2$d."
msgstr "無法取得 %1$s %2$d 的 URL。"

#: includes/add-shorturl-column.php
msgid "Copied!"
msgstr "已複製！"

#: includes/add-shorturl-column.php
msgid "Invalid post ID or type."
msgstr "無效的 ID 或類型。"

#: includes/add-shorturl-column.php
msgid "Lihi login failed. Please check the email in Settings → Lihi Short URL."
msgstr "Lihi 登入失敗，請確認「設定 → Lihi 短網址」的 Email 是否正確。"

#: includes/add-shorturl-column.php
msgid "Lihi email is not configured. Please set it in Settings → Lihi Short URL."
msgstr "Lihi 尚未設定 Email，請至「設定 → Lihi 短網址」填寫。"

#: includes/add-shorturl-column.php
msgid "Lihi API rejected the request data."
msgstr "Lihi API 拒絕此請求的資料。"

#: includes/add-shorturl-column.php
msgid "Failed to generate short URL. Please try again later."
msgstr "產生短網址失敗，請稍後再試。"

#: includes/settings.php
msgid "Email"
msgstr "Email"

#: includes/settings.php
msgid "Lihi Short URL"
msgstr "Lihi 短網址"

#: includes/settings.php
msgid "Required. The email address used to log in to the Lihi API."
msgstr "必填。用於登入 Lihi API 的 Email 地址。"

#: includes/settings.php
msgid "Lihi Short URL Settings"
msgstr "Lihi 短網址設定"


#: bootstrap.php
msgid "Lihi Short URL: please <a href=\"%s\">configure your email address</a> to enable the plugin."
msgstr "Lihi 短網址：請先至 <a href=\"%s\">設定頁</a> 填寫 Email 以啟用外掛。"

#. Description of the plugin
msgid "Adds a one-click \"Lihi\" button to generate and copy short URLs, including posts, pages, media and all post-type list tables."
msgstr "在列表中新增一鍵生成短網址並複製的按鈕 \"Lihi\"，包含文章、頁面與媒體等所有內容行列表。"
