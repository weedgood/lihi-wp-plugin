#: includes/add-lihi-column.php
#: includes/add-shorturl-column.php
msgid "Short URL"
msgstr "短網址"

#: includes/service/lihi-service.php
msgid "No token returned from lihi API."
msgstr "lihi API 未回傳 token。"

#: includes/service/lihi-service.php
msgid "No short_url returned from lihi API."
msgstr "lihi API 未回傳 short_url。"

#: includes/service/lihi-service.php
msgid "No passthrough nonce returned from lihi API."
msgstr "lihi API 未回傳 passthrough nonce。"

#: includes/helper.php
msgid "Could not resolve WordPress site host."
msgstr "無法解析 WordPress 站台主機名稱。"

#: includes/service/lihi-service.php
msgid "Could not resolve URL for %1$s %2$d."
msgstr "無法取得 %1$s %2$d 的 URL。"

#: includes/add-shorturl-column.php
msgid "Copied!"
msgstr "已複製！"

#: includes/add-shorturl-column.php
msgid "Clipboard access was blocked. Copy this short URL:"
msgstr "瀏覽器封鎖剪貼簿存取，請複製此短網址："

#: includes/add-shorturl-column.php
msgid "Copy"
msgstr "複製"

#: includes/add-shorturl-column.php
msgid "Edit"
msgstr "編輯"

#: includes/add-shorturl-column.php
msgid "Create lihi Short URL"
msgstr "建立 lihi 短網址"

#: includes/add-shorturl-column.php
msgid "Domain"
msgstr "網域"

#: includes/add-shorturl-column.php
msgid "No redirect domains are available for this lihi account."
msgstr "此 lihi 帳號沒有可用的轉址網域。"

#: includes/add-shorturl-column.php
msgid "Tags"
msgstr "標籤"

#: includes/add-shorturl-column.php
msgid "Add"
msgstr "新增"

#: includes/add-shorturl-column.php
msgid "Remove tag"
msgstr "移除標籤"

#: includes/add-shorturl-column.php
msgid "UTM source"
msgstr "UTM source"

#: includes/add-shorturl-column.php
msgid "UTM medium"
msgstr "UTM medium"

#: includes/add-shorturl-column.php
msgid "UTM campaign"
msgstr "UTM campaign"

#: includes/add-shorturl-column.php
msgid "UTM term"
msgstr "UTM term"

#: includes/add-shorturl-column.php
msgid "UTM content"
msgstr "UTM content"

#: includes/add-shorturl-column.php
msgid "Cancel"
msgstr "取消"

#: includes/add-shorturl-column.php
msgid "Create & Copy"
msgstr "建立並複製"

#: includes/add-shorturl-column.php
msgid "Loading..."
msgstr "載入中..."

#: includes/add-shorturl-column.php
msgid "OK"
msgstr "確定"

#: includes/add-shorturl-column.php
msgid "Go to the lihi dashboard to edit this short URL?"
msgstr "是否前往 lihi 後台編輯短網址？"

#: includes/add-shorturl-column.php
msgid "Your browser blocked the lihi edit tab. Please allow pop-ups and try again."
msgstr "瀏覽器已阻擋 lihi 編輯分頁，請允許彈出視窗後再試一次。"

#: includes/add-shorturl-column.php
msgid "Your browser does not support secure lihi edit verification."
msgstr "您的瀏覽器不支援安全的 lihi 編輯驗證。"

#: includes/add-shorturl-column.php
msgid "Could not verify browser session. Please refresh the page and try again."
msgstr "無法驗證瀏覽器工作階段，請重新整理頁面後再試一次。"

#: includes/shorturl-column-ajax.php
msgid "Please choose a redirect domain."
msgstr "請選擇轉址網域。"

#: includes/shorturl-column-ajax.php
msgid "Could not resolve client IP address."
msgstr "無法取得使用者 IP。"

#: includes/shorturl-column-ajax.php
msgid "Could not verify browser session. Please try again."
msgstr "無法驗證瀏覽器工作階段，請再試一次。"

#: includes/shorturl-column-ajax.php
msgid "You do not have permission to edit lihi short URLs."
msgstr "您沒有編輯 lihi 短網址的權限。"

#: includes/shorturl-column-ajax.php
msgid "Short URL has been removed. Please create it again."
msgstr "短網址已遭移除，請重新建立。"

#: includes/shorturl-column-ajax.php
msgid "Invalid post ID or type."
msgstr "無效的 ID 或類型。"

#: includes/shorturl-column-ajax.php
msgid "You do not have permission to generate a short URL for this item."
msgstr "您沒有權限為此項目產生短網址。"

#: includes/shorturl-column-ajax.php
msgid "Your lihi email has not been verified yet. Please open Settings → lihi Short URL and click Save & Verify to resend the verification email."
msgstr "您的 lihi Email 尚未完成驗證，請至「設定 → lihi 短網址」點擊「儲存並驗證」重新寄送驗證信。"

#: includes/settings.php
#: includes/shorturl-column-ajax.php
msgid "Your lihi account is unavailable. Please contact lihi support before creating short URLs."
msgstr "您的 lihi 帳號目前不可使用，請聯絡 lihi 客服後再建立短網址。"

#: includes/settings.php
#: includes/shorturl-column-ajax.php
msgid "Your lihi login session has expired. Please try again."
msgstr "lihi 登入狀態已過期，請再試一次。"

#: includes/shorturl-column-ajax.php
msgid "lihi email is not configured. Please set it in Settings → lihi Short URL."
msgstr "lihi 尚未設定 Email，請至「設定 → lihi 短網址」填寫。"

#: includes/shorturl-column-ajax.php
#. translators: %s: validation error message returned by the lihi API.
msgid "lihi API rejected the request: %s"
msgstr "lihi API 拒絕此請求：%s"

#: includes/shorturl-column-ajax.php
msgid "Request failed. Please try again later."
msgstr "請求失敗，請稍後再試。"

#: includes/shorturl-column-ajax.php
msgid "Failed to copy short URL. Please try again later."
msgstr "複製短網址失敗，請稍後再試。"

#: includes/shorturl-column-ajax.php
msgid "Failed to generate short URL. Please try again later."
msgstr "產生短網址失敗，請稍後再試。"

#: includes/shorturl-column-ajax.php
msgid "Failed to open lihi dashboard. Please try again later."
msgstr "無法開啟 lihi 後台，請稍後再試。"

#: includes/settings.php
msgid "Email"
msgstr "Email"

#: includes/settings.php
msgid "lihi Short URL"
msgstr "lihi 短網址"

#: includes/settings.php
msgid "Email used to authenticate with the lihi service. Saving sends a verification email; the plugin can be used after verification is complete."
msgstr "用於 lihi 服務驗證身分的 Email；儲存後會寄送驗證信，驗證完成後方可使用套件。"

#: includes/settings.php
msgid "lihi email cleared. Short URL generation is disabled until a new email is verified."
msgstr "已清除 lihi Email；在新 Email 完成驗證前，短網址功能將停用。"

#: includes/settings.php
msgid "lihi Short URL Settings"
msgstr "lihi 短網址設定"

#: includes/settings.php
msgid "Save & Verify"
msgstr "儲存並驗證"

#: includes/settings.php
msgid "You do not have permission to update this setting."
msgstr "您沒有權限更新此設定。"

#: includes/settings.php
msgid "Please enter a valid email address."
msgstr "請輸入有效的 Email 地址。"

#: includes/settings.php
msgid "lihi rejected the email address. Please check the format and try again."
msgstr "lihi 拒絕了此 Email 地址，請確認格式後再試一次。"

#: includes/settings.php
msgid "The lihi service is unavailable. Please try again later."
msgstr "lihi 服務目前無法連線，請稍後再試。"

#: includes/settings.php
msgid "Too many verification attempts. Please wait a moment and try again."
msgstr "驗證嘗試過於頻繁，請稍候再試。"

#: includes/settings.php
msgid "✓ Email verified."
msgstr "✓ Email 已驗證。"

#: includes/settings.php
msgid "Verification email sent. Please click the link in that email to finish verification."
msgstr "驗證信已寄出，請點擊信中的連結完成驗證。"

#: includes/settings.php
msgid "Email not verified yet. Click Save & Verify to resend the verification email."
msgstr "Email 尚未完成驗證，請點擊「儲存並驗證」重新寄送驗證信。"

#: includes/settings.php
msgid "The lihi service is temporarily unavailable. Please try again later."
msgstr "lihi 服務目前無法連線，請稍後再試。"

#: includes/settings.php
msgid "Could not load account information."
msgstr "無法載入帳號資訊。"

#: includes/settings.php
msgid "Account"
msgstr "帳號"

#: includes/settings.php
msgid "Subscribe Plan"
msgstr "訂閱方案"

#: includes/settings.php
msgid "Plan End Date"
msgstr "方案到期日"

#: includes/settings.php
msgid "(none)"
msgstr "（無）"

#: includes/settings.php
msgid "—"
msgstr "—"

#. Description of the plugin
msgid "Adds a one-click \"lihi\" button to generate and copy short URLs, including posts, pages, media and all post-type list tables."
msgstr "在列表中新增一鍵生成短網址並複製的按鈕 \"lihi\"，包含文章、頁面與媒體等所有內容行列表。"
